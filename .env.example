# Path to the PGlite data directory (created automatically on first run)
PGLITE_DATA_DIR=./DB

# USASpending.gov — no key required for public endpoints, but set if you have one
USA_SPENDING_API_KEY=

# Census Bureau API key (free at api.census.gov/data/key_signup.html)
CENSUS_API_KEY=

# API server
API_PORT=3001
API_HOST=0.0.0.0

# Web dev server
VITE_API_URL=http://localhost:3001
